  "architecture": {
    "model_family": "quantum-centred variational quantum classifier",
    "feature_map": {
      "class": "ZZFeatureMap",
      "feature_dimension": "n_qubits",
      "reps": 2,
      "entanglement": "linear",
      "input_transform": "identity; use stored MinMax-scaled PCA scores directly"
    },
    "ansatz": {
      "class": "EfficientSU2",
      "reps": 2,
      "entanglement": "linear",
      "rotation_gates": ["ry", "rz"],
      "trainable_parameter_count": "measured from the installed Qiskit circuit"
    },
    "readout": {
      "mode": "marginals_zz_neighbors",
      "measurement_features": "P(qubit_i=0) for i=0..q-1 followed by <Z_i Z_(i+1)> for i=0..q-2",
      "feature_count": "2*n_qubits-1",
      "bitstring_convention": "Qiskit little-endian; bitstring[-1] is qubit 0",
      "classical_decoder": {
        "type": "one-hidden-layer MLP",
        "hidden_units": 16,
        "output_units": 13,
        "activation": "ReLU hidden layer and softmax output",
        "parameter_count_formula": "(measurement_features*16+16)+(16*13+13)"
      }
    }
  },
  "training": {
    "optimizer": "QNSPSA-EML-Feynman",
    "max_iterations": 20,
    "batch_size": 32,
    "shots": 512,
    "learning_rate": 0.03,
    "initialization_seed": 42,
    "training_random_seed": 42,
    "qnspsa": {
      "perturbation": 0.05,
      "lambda_eml": 0.01,
      "hessian_regularization": 0.0001,
      "blocking_delta": 0.001,
      "n_feynman_params": 4,
      "n_gl_points": 8,
      "patience": 20,
      "min_improvement": 0.0005
    },
    "readout_initialization": "Train-only quantum-measurement warm start; up to 200 examples, random seed 49.",
    "readout_refit_every": 10,
    "progress_metrics": {
      "record_every_iteration": true,
      "fixed_train_diagnostic_samples_per_class": 5,
      "fixed_validation_diagnostic_samples_per_class": 5,
      "validation_role": "metrics only; never used for loss, gradient, optimizer, or parameter fitting",
      "diagnostic_simulator_seed": 42042
    },
    "final_metrics": "Evaluate all train and validation examples using quantum measurement features and the trained classical readout."
  },
  "simulator": {
    "provider": "Qiskit Aer",
    "backend": "AerSimulator",
    "method": "matrix_product_state",
    "local": true,
    "seed_simulator": 42,
    "hardware_execution": false
